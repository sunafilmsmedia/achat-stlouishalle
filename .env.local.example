# ── IA (optionnel) ──────────────────────────────────────────────────────────
# Sans clé, l'app utilise un rapport déterministe de fallback (buildFallbackReport).
ANTHROPIC_API_KEY=

# ── CRM / GHL (optionnel) ────────────────────────────────────────────────────
# Sans webhook, les leads qualifiés sont journalisés côté serveur.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# ── Tracking (optionnel, côté client) ────────────────────────────────────────
# Laisser vide = aucun script chargé.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
